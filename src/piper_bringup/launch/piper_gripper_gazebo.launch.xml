<launch>

    <set_env name="LIBGL_ALWAYS_SOFTWARE" value="1" />

    <let name="urdf_path"
        value="$(find-pkg-share piper_description)/urdf/piper_description_gazebo.xacro" />

    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="use_sim_time" value="true" />
        <param name="robot_description"
            value="$(command 'xacro $(var urdf_path)')" />
    </node>

    <node pkg="controller_manager" exec="spawner"
        args="joint_state_broadcaster --controller-manager /controller_manager --controller-manager-timeout 60" />
    <node pkg="controller_manager" exec="spawner"
        args="arm_controller --controller-manager /controller_manager --controller-manager-timeout 60" />
    <node pkg="controller_manager" exec="spawner"
        args="gripper_controller --controller-manager /controller_manager --controller-manager-timeout 60" />
    <node pkg="controller_manager" exec="spawner"
        args="gripper8_controller --controller-manager /controller_manager --controller-manager-timeout 60" />

    <node pkg="piper_gazebo" exec="joint8_ctrl.py" output="screen" />

    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="empty.sdf -r" />
    </include>

    <node pkg="ros_gz_sim" exec="create"
        args="-world empty -name piper -topic robot_description" />

    <node pkg="ros_gz_bridge" exec="parameter_bridge"
        args="/clock@rosgraph_msgs/msg/Clock[gz.msgs.Clock"
        output="screen" />

    <include file="$(find-pkg-share piper_with_gripper_moveit)/launch/piper_moveit.launch.py" />

</launch>
