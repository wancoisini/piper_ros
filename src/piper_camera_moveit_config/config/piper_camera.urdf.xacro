<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="piper_camera">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import piper_camera urdf file -->
    <xacro:include filename="$(find piper_description)/urdf/piper_description_v100_realsense_camera_v2.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="piper_camera.ros2_control.xacro" />


    <xacro:piper_camera_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
