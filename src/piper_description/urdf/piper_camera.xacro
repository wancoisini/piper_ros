<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <link name="d435_camera_link"/>
  <!-- camera body, with origin at bottom screw mount -->
    <joint name="camera_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <parent link="d435_camera_link"/>
        <child link="camera_bottom_screw_frame"/>
    </joint>

    <link name="camera_bottom_screw_frame"/>

    <joint name="camera_link_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0.010600000000000002 0.0175 0.0125"/>
        <parent link="camera_bottom_screw_frame"/>
        <child link="camera_link"/>
    </joint>

    <link name="camera_link">
        <visual>
      <!-- the mesh origin is at front plate in between the two infrared camera axes -->
            <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0.0043 -0.0175 0"/>
            <geometry>
            <mesh filename="file://$(find piper_description)/meshes/dae/d435.dae"/>
            </geometry>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 -0.0175 0"/>
            <geometry>
            <box size="0.02505 0.09 0.025"/>
        </geometry>
        </collision>
        <inertial>
      <!-- The following are not reliable values, and should not be used for modeling -->
            <mass value="0.072"/>
            <origin xyz="0 0 0"/>
            <inertia ixx="0.003881243" ixy="0.0" ixz="0.0" iyy="0.000498940" iyz="0.0" izz="0.003879257"/>
        </inertial>
  </link>

    <link name="camera_stand_link">
        <inertial>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            <mass value="0.0"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>
        <visual name="">
            <origin rpy="0.0 3.14 1.57" xyz="0.0 0.0 0.0"/>
            <geometry>
            <mesh filename="file://$(find piper_description)/meshes/dae/realsense_mid_stand.dae"/>
            </geometry>
        </visual>
        <collision>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            <geometry>
            <mesh filename="file://$(find piper_description)/meshes/dae/realsense_mid_stand.dae"/>
            </geometry>
        </collision>
  </link>
  <joint name="camera_stand_joint" type="fixed">
    <origin rpy="-1.57 0.0 0.0" xyz="-0.001 0.032 0.022"/>
    <parent link="link6"/>
    <child link="camera_stand_link"/>
    <axis xyz="0.0 0.0 0.0"/>
    <limit effort="0.0" lower="0.0" upper="0.0" velocity="0.0"/>
  </joint>
  <joint name="d435_camera_joint" type="fixed">
    <origin rpy="0.0 -1.22 -1.57" xyz="-0.029 0.065 0.022"/>
    <parent link="link6"/>
    <child link="d435_camera_link"/>
    <axis xyz="0.0 0.0 0.0"/>
    <limit effort="0.0" lower="0.0" upper="0.0" velocity="0.0"/>
  </joint>
  
</robot>