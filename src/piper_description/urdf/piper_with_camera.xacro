<?xml version="1.0" encoding="utf-8"?>
<robot
  name="piper_camera"
  xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find piper_description)/urdf/piper_description_v100_realsense_camera_v2.urdf.xacro"/>
  <xacro:include filename="$(find piper_description)/urdf/piper_gripper.ros2_controller.xacro"/>
  <xacro:include filename="$(find piper_description)/urdf/piper_gripper_gazebo.xacro" />
  <xacro:include filename="$(find piper_description)/urdf/piper_camera_gazebo.xacro" />


</robot>